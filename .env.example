# Authentication URLs
AUTH_ORIGIN=http://localhost:3000/api/auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# Google OAuth (optional - only needed for Google login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Database Configuration
DB_HOST=localhost
DB_USER=your-db-username
DB_PASSWORD=your-db-password
DB_NAME=qwizhub
DB_PORT=5432

# AI Provider - OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=deepseek/deepseek-chat
# Alternative models:
# - deepseek/deepseek-v4-pro (more powerful, more expensive)
# - google/gemini-2.0-flash-exp:free (free tier)
# - meta-llama/llama-3.1-8b-instruct:free (free tier)
# - anthropic/claude-3.5-sonnet (best quality)
# See https://openrouter.ai/models for full list

# AI Rate Limiting
AI_RATE_LIMIT_REQUESTS=5
AI_RATE_LIMIT_WINDOW_MINUTES=60
AI_REQUEST_TIMEOUT_MS=30000

# Site URL (for OpenRouter HTTP-Referer header)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Midtrans Payment Gateway Configuration
# Get your keys from: https://dashboard.midtrans.com/ (Sandbox or Production)
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SERVER_KEY_HERE
MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_CLIENT_KEY_HERE
MIDTRANS_IS_PRODUCTION=false

# IMPORTANT: Configure Payment Notification URL in Midtrans Dashboard:
# Development: http://localhost:3000/api/webhooks/midtrans (use ngrok for testing)
# Production: https://qwizhub.up.railway.app/api/webhooks/midtrans